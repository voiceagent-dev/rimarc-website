# Copy to .env and fill in. Never commit the real .env file.

NODE_ENV=production
PORT=8080
# Your site's address(es). Must be https in production.
PUBLIC_ORIGINS=https://rimarcai.com,https://www.rimarcai.com
# Main address; rimarcai.com (without www) is redirected here
CANONICAL_HOST=www.rimarcai.com
# 1 if the app runs behind one proxy or load balancer (Render, Railway, Nginx, Cloudflare...)
TRUST_PROXY=1

# "mock" = form works but no real call.
# "live" = the website calls Vapi directly (needs the VAPI_* values below).
# "n8n"  = the website sends each validated request to your n8n workflow, which calls Vapi.
DEMO_CALL_MODE=mock
# n8n mode: the workflow's Production webhook URL, e.g. https://yourname.app.n8n.cloud/webhook/rimarc-demo-call
N8N_DEMO_WEBHOOK_URL=
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
# Shared secret Vapi sends in the "x-vapi-secret" header to /api/vapi/webhook
VAPI_WEBHOOK_SECRET=

# Random string of at least 32 characters. Generate with: openssl rand -hex 32
HASH_SECRET=

# Countries we call (ISO codes) and the calling window
ALLOWED_CALL_COUNTRIES=IN
CALL_TIMEZONE=Asia/Kolkata
CALL_WINDOW_START_HOUR=9
CALL_WINDOW_END_HOUR=21

# Optional: Cloudflare Turnstile bot protection (server secret)
TURNSTILE_SECRET_KEY=

# Optional: Make / n8n / Zapier webhooks
CONTACT_WEBHOOK_URL=
LEAD_WEBHOOK_URL=
# Sent as the "X-Rimarc-Secret" header so n8n/Make can verify requests come from this site (24+ characters; required in n8n mode)
OUTBOUND_WEBHOOK_SECRET=
